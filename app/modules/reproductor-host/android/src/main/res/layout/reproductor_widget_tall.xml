<?xml version="1.0" encoding="utf-8"?>
<!-- The widget narrow but tall (two cells wide and two or more high): what plays on top, its buttons below across the
     whole width, the progress bar at the bottom; over its cover. PlayerWidget sizes the buttons and the text to it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reproductor_widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/rw_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/rw_cover_none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/reproductor_widget_scrim_tall"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/rw_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rw_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/rw_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/reproductor_widget_button_bg"
                android:src="@drawable/reproductor_widget_prev"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/reproductor_widget_prev" />

            <ImageButton
                android:id="@+id/rw_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/reproductor_widget_play_bg"
                android:src="@drawable/reproductor_widget_play"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/reproductor_widget_play" />

            <ImageButton
                android:id="@+id/rw_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/reproductor_widget_button_bg"
                android:src="@drawable/reproductor_widget_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/reproductor_widget_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/rw_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/reproductor_widget_progress" />
    </LinearLayout>
</FrameLayout>
